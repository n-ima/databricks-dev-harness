{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node tools/agent-hook.mjs context --provider copilot",
        "powershell": "node tools/agent-hook.mjs context --provider copilot",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell|edit|create|apply_patch",
        "bash": "node tools/agent-hook.mjs policy --provider copilot",
        "powershell": "node tools/agent-hook.mjs policy --provider copilot",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [{ "type": "command", "bash": "node tools/agent-hook.mjs stop --provider copilot", "powershell": "node tools/agent-hook.mjs stop --provider copilot", "cwd": ".", "timeoutSec": 10 }],
    "preCompact": [{ "type": "command", "bash": "node tools/agent-hook.mjs compact --provider copilot", "powershell": "node tools/agent-hook.mjs compact --provider copilot", "cwd": ".", "timeoutSec": 10 }],
    "postToolUseFailure": [{ "type": "command", "bash": "node tools/agent-hook.mjs failure --provider copilot", "powershell": "node tools/agent-hook.mjs failure --provider copilot", "cwd": ".", "timeoutSec": 10 }]
  }
}
