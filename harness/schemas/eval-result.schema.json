{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/databricks-dev-harness/eval-result.schema.json",
  "title": "Harness evaluation result",
  "type": "object",
  "required": ["schemaVersion", "runId", "taskId", "provider", "attempt", "status", "startedAt", "finishedAt", "metrics", "evidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["claude", "copilot", "manual"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["passed", "failed", "blocked", "invalid"] },
    "metrics": {
      "type": "object",
      "required": ["iterations", "wallSeconds", "humanInterventions"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 0 },
        "wallSeconds": { "type": "number", "minimum": 0 },
        "humanInterventions": { "type": "integer", "minimum": 0 },
        "credits": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
