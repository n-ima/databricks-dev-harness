{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/databricks-dev-harness/intake.schema.json",
  "title": "Product intake manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "status", "sources", "questions", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "needs-answers", "ready-for-approval", "accepted", "superseded"] },
    "sources": { "type": "array", "items": { "type": "object", "required": ["path", "sha256"] } },
    "questions": { "type": "array", "items": { "type": "object", "required": ["id", "question", "material", "status"] } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
